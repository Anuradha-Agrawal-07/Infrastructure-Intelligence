{
  "scenario_id": "error-rate-spike",
  "name": "Synthetic Error Rate Spike",
  "category": "availability",
  "description": "Generate bounded synthetic error-rate telemetry for incident testing.",
  "risk_level": "LOW",
  "injector_type": "synthetic_error_rate",
  "parameters": {
    "error_rate": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 1.0,
      "default": 0.25
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 5
    }
  },
  "expected_signals": [
    "error_rate",
    "http_5xx_rate"
  ],
  "recovery_required": true,
  "verification_required": true
}
